{
  "name": "@repo/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "job:daily-plan": "tsx src/index.ts daily-plan",
    "job:market-benchmark": "tsx src/index.ts market-benchmark",
    "job:weekly-review": "tsx src/index.ts weekly-review"
  },
  "dependencies": {
    "@repo/hermes": "workspace:*",
    "@repo/planner": "workspace:*",
    "@repo/scoring": "workspace:*",
    "@repo/search": "workspace:*",
    "@repo/shared": "workspace:*",
    "@repo/slack": "workspace:*",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "eslint": "^9.39.1",
    "tsx": "^4.22.4",
    "typescript": "5.9.2"
  }
}
