    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@repo/ai-chat-ingestors": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/shared": "workspace:*",
    "chokidar": "^5.0.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "eslint": "^9.39.1",
    "tsx": "^4.22.4",
    "typescript": "5.9.2"
  }
}
