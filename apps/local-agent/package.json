{
  "name": "@repo/local-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "devrank-local-agent": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
