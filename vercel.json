{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build --filter web...",
  "installCommand": "pnpm install",
  "framework": "nextjs",
  "nodeVersion": "22.x",
  "crons": [
    {
      "path": "/api/cron/daily-plan",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/weekly-review",
      "schedule": "30 3 * * 0"
    }
  ]
}
