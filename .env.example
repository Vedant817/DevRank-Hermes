# DevRank OS — Environment Variables
#
# Copy this file to .env and fill in your values.
# Required for deployment — set every uncommented variable before starting.
#
# ----- GENERATE SECURE TOKENS -----
#   openssl rand -hex 32   (for DEVRANK_API_TOKEN, CRON_SECRET, etc.)
# ----- GENERATE PASSWORDS -----
#   openssl rand -base64 24  (for DEVRANK_DASHBOARD_TOKEN)

# =============================================================================
# REQUIRED — Must be set for the dashboard to serve
# =============================================================================

# One of these Postgres connection strings. Neon free tier recommended.
# Get from: Neon Console -> Project -> Connection Details -> Connection string
# DATABASE_URL=postgresql://user:pass@ep-xxxx.us-east-2.aws.neon.tech/devrank?sslmode=require

# Single-user owner identifier. Any short string (alphanumeric + hyphens/underscores).
DEVRANK_OWNER_ID=

# Dashboard Basic-auth token. Set a strong password here.
DEVRANK_DASHBOARD_TOKEN=

# Must match the username your browser Basic-auth popup sends.
DEVRANK_DASHBOARD_USER=devrank

# Shared API auth token used for route-to-route calls.
DEVRANK_API_TOKEN=

# Secret that Vercel cron jobs send as Authorization header.
# Must match what you set in Vercel's CRON_SECRET env var.
CRON_SECRET=

# =============================================================================
# REQUIRED for scoring — must be set for computeSdeReadinessSnapshot
# =============================================================================

# The token used by internal API routes that create score snapshots.
DEVRANK_SCORE_RECOMPUTE_TOKEN=

# =============================================================================
# OPTIONAL — Integrations
# =============================================================================

# --- Slack (daily plan delivery + task buttons) ---
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00/B00/xxxx
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CHANNEL_ID=C00000000
# SLACK_SIGNING_SECRET=xxxx

# --- GitHub (backfill + webhooks) ---
# GITHUB_PERSONAL_ACCESS_TOKEN=github_pat_...
# GITHUB_TOKEN=github_pat_...
# GITHUB_APP_ID=
# GITHUB_INSTALLATION_ID=
# GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_WEBHOOK_SECRET=

# --- Linear (priority task extraction) ---
# LINEAR_API_KEY=lin_api_...
# LINEAR_WEBHOOK_SECRET=

# --- Market benchmark search ---
# TAVILY_API_KEY=tvly-...

# --- Optional route-specific tokens (overrides DEVRANK_API_TOKEN per route) ---
# DEVRANK_CONTEXT_READ_TOKEN=
# DEVRANK_CONTEXT_WRITE_TOKEN=
# DEVRANK_INGEST_TOKEN=
# DEVRANK_SLACK_SEND_TOKEN=
# DEVRANK_LINEAR_BACKFILL_TOKEN=
# DEVRANK_PLANNER_TOKEN=
# DEVRANK_HERMES_REVIEW_TOKEN=

# --- AI provider (Hermes mentor summaries) ---
# OPENROUTER_API_KEY=sk-or-v1-...
# GROQ_API_KEY=gsk_...
# AI_MODEL=openrouter/auto

# --- Embeddings (optional, for skill evidence search) ---
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=openai/text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# --- Supabase (optional, for context provider) ---
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
