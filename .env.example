# DevRank OS — Environment Variables
#
# Copy this file to .env, replace every change_me value, then:
#   pnpm devrank trial:score --user <github-user>   # test scoring
#   pnpm run dev                                     # start local server
#
# Generate tokens with:
#   openssl rand -hex 32   (for DEVRANK_API_TOKEN, CRON_SECRET, etc.)
#   openssl rand -base64 24  (for DEVRANK_DASHBOARD_TOKEN)

# =============================================================================
# REQUIRED — Must be set for the dashboard + server to start
# =============================================================================

# Postgres connection string. Free options: Neon (neon.tech) or local Postgres.
# Local example: DATABASE_URL=postgresql://user:pass@localhost:5432/devrank
DATABASE_URL=postgresql://change_me:change_me@ep-xxxx.us-east-2.aws.neon.tech/devrank?sslmode=require

# Single-user owner identifier. Any short alphanumeric string.
DEVRANK_OWNER_ID=change_me

# Dashboard Basic-auth password. Browser will prompt on /dashboards/* pages.
DEVRANK_DASHBOARD_TOKEN=change_me_to_a_secure_token

# Username for Basic-auth popup (default: devrank).
DEVRANK_DASHBOARD_USER=devrank

# Shared API auth token used for route-to-route calls.
DEVRANK_API_TOKEN=change_me_to_a_secure_token

# Secret for Vercel cron job authorization (must match CRON_SECRET in Vercel env).
CRON_SECRET=change_me_to_a_secure_token

# =============================================================================
# REQUIRED for scoring — must be set for computeSdeReadinessSnapshot
# =============================================================================

# Token used by internal API routes that create score snapshots.
DEVRANK_SCORE_RECOMPUTE_TOKEN=change_me_to_a_secure_token
DEVRANK_PLANNER_TOKEN=change_me_to_a_secure_token

# =============================================================================
# OPTIONAL — Integrations (uncomment and fill the ones you need)
# =============================================================================

# --- Slack (daily plan delivery + interactive task buttons) ---
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00/B00/xxxx
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CHANNEL_ID=C...
# SLACK_SIGNING_SECRET=...

# --- GitHub (backfill + webhook ingestion) ---
# GITHUB_TOKEN=github_pat_...
# GITHUB_TRIAL_PAT=github_pat_... # Optional read-only token for public trial scoring
# GITHUB_WEBHOOK_SECRET=...

# --- GitLab (read-only project, commit, and merge-request backfill) ---
# GITLAB_TOKEN=glpat_... # Optional for public projects; sent only as PRIVATE-TOKEN
# GITLAB_BASE_URL=https://gitlab.com/api/v4 # Optional for self-managed GitLab

# --- Linear (priority task extraction from issue tracker) ---
# LINEAR_API_KEY=lin_api_...

# --- Market benchmark search (skill gap analysis) ---
# TAVILY_API_KEY=tvly-...

# --- AI provider (Hermes mentor weekly summaries) ---
# OPENROUTER_API_KEY=sk-or-v1-...
# AI_MODEL=openrouter/auto

# === Route-specific tokens (optional — override DEVRANK_API_TOKEN per route) ===
# DEVRANK_INGEST_TOKEN=change_me_to_a_secure_token
# DEVRANK_LINEAR_BACKFILL_TOKEN=change_me_to_a_secure_token
# DEVRANK_HERMES_REVIEW_TOKEN=change_me_to_a_secure_token

# === Embeddings (optional, for skill evidence search) ===
# EMBEDDING_MODEL=openai/text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# === Supabase (optional context provider) ===
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=...
