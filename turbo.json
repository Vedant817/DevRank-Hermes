{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "AI_API_KEY",
    "AI_BASE_URL",
    "AI_HTTP_REFERER",
    "AI_MODEL",
    "AI_TITLE",
    "CONTEXT_PROVIDER",
    "CRON_SECRET",
    "DATABASE_URL",
    "DEVRANK_API_TOKEN",
    "DEVRANK_CONTEXT_READ_TOKEN",
    "DEVRANK_CONTEXT_WRITE_TOKEN",
    "DEVRANK_DATABASE_URL",
    "DEVRANK_DASHBOARD_TOKEN",
    "DEVRANK_DASHBOARD_USER",
    "DEVRANK_HERMES_REVIEW_TOKEN",
    "DEVRANK_INGEST_TOKEN",
    "DEVRANK_LINEAR_BACKFILL_TOKEN",
    "DEVRANK_LOCAL_AGENT_LOG_PATH",
    "DEVRANK_LOCAL_AGENT_CONFIG",
    "DEVRANK_LOCAL_INGEST_ROOTS",
    "DEVRANK_OWNER_ID",
    "DEVRANK_PLANNER_TOKEN",
    "DEVRANK_REDACT_SECRETS",
    "DEVRANK_SCORE_RECOMPUTE_TOKEN",
    "DEVRANK_SLACK_SEND_TOKEN",
    "DEVRANK_STORE_EMBEDDINGS",
    "DEVRANK_TRUST_PROXY_IP_HEADERS",
    "DEVRANK_UPLOAD_RAW_CHATS",
    "EMBEDDING_API_KEY",
    "EMBEDDING_BASE_URL",
    "EMBEDDING_DIMENSIONS",
    "EMBEDDING_MODEL",
    "EXA_API_KEY",
    "FIRECRAWL_API_KEY",
    "GITHUB_APP_ID",
    "GITHUB_INSTALLATION_ID",
    "GITHUB_PERSONAL_ACCESS_TOKEN",
    "GITHUB_PRIVATE_KEY",
    "GITHUB_PRIVATE_KEY_PATH",
    "GITHUB_TOKEN",
    "GITHUB_WEBHOOK_SECRET",
    "LINEAR_API_KEY",
    "LINEAR_WEBHOOK_SECRET",
    "LOCAL_AGENT_REDACT_SECRETS",
    "LOCAL_AGENT_UPLOAD_RAW_CHATS",
    "OPENROUTER_API_KEY",
    "OPENROUTER_BASE_URL",
    "HERMES_MODEL",
    "HERMES_HTTP_REFERER",
    "HERMES_TITLE",
    "SLACK_WEBHOOK_URL",
    "SUPABASE_DATABASE_URL",
    "SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "SUPABASE_URL",
    "SUPERMEMORY_API_KEY",
    "SUPERMEMORY_PROJECT_ID",
    "TAVILY_API_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
